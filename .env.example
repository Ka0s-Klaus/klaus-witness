# Database
DATABASE_URL=postgresql://testigo:testigo_pass@postgres:5432/testigo_db
POSTGRES_USER=testigo
POSTGRES_PASSWORD=testigo_pass
POSTGRES_DB=testigo_db

# API
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# LLM (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# Auth
SECRET_KEY=your-secret-key-change-in-production-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (para Celery)
REDIS_URL=redis://redis:6379/0

# Frontend
REACT_APP_API_URL=http://localhost:8000/api

# Consolidador
CONSOLIDATION_HOUR=2
CONSOLIDATION_ENABLED=True
